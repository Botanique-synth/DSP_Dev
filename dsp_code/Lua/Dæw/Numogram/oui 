import("stdfaust.lib");

vlm() = hgroup("vlm",v1,v2,v3,v4,v5,v6)
with{
    v1 = vslider("va",0,0,1,0.01);
    v2 = vslider("vb",0,0,1,0.01);
    v3 = vslider("vc",0,0,1,0.01);
    v4 = vslider("vd",0,0,1,0.01);
    v5 = vslider("ve",0,0,1,0.01);
    v6 = vslider("vf",0,0,1,0.01);
};

send_fx_a() = hgroup("send_fx_a",sa1,sa2,sa3,sa4,sa5,sa6)
with{
    sa1 = vslider("sa1[style:knob]",0,0,1,0.01);
    sa2 = vslider("sa2[style:knob]",0,0,1,0.01);
    sa3 = vslider("sa3[style:knob]",0,0,1,0.01);
    sa4 = vslider("sa4[style:knob]",0,0,1,0.01);
    sa5 = vslider("sa5[style:knob]",0,0,1,0.01);
    sa6 = vslider("sa6[style:knob]",0,0,1,0.01);
};

send_fx_b() = hgroup("send_fx_b",sb1,sb2,sb3,sb4,sb5,sb6)
with{
    sb1 = vslider("sb1[style:knob]",0,0,1,0.01);
    sb2 = vslider("sb2[style:knob]",0,0,1,0.01);
    sb3 = vslider("sb3[style:knob]",0,0,1,0.01);
    sb4 = vslider("sb4[style:knob]",0,0,1,0.01);
    sb5 = vslider("sb5[style:knob]",0,0,1,0.01);
    sb6 = vslider("sb6[style:knob]",0,0,1,0.01);
};

l1 = vslider("la[style:knob]",0,0,1,0.01);
l2 = vslider("lb[style:knob]",0,0,1,0.01);
l3 = vslider("lc[style:knob]",0,0,1,0.01);
l4 = vslider("ld[style:knob]",0,0,1,0.01);
l5 = vslider("le[style:knob]",0,0,1,0.01);
l6 = vslider("lf[style:knob]",0,0,1,0.01);

h1 = vslider("ha[style:knob]",0,0,1,0.01);
h2 = vslider("hb[style:knob]",0,0,1,0.01);
h3 = vslider("hc[style:knob]",0,0,1,0.01);
h4 = vslider("hd[style:knob]",0,0,1,0.01);
h5 = vslider("he[style:knob]",0,0,1,0.01);
h6 = vslider("hf[style:knob]",0,0,1,0.01);

in1 = _,_ ;
in2 = _,_ ;
in3 = _,_ ;
in4 = _,_ ;

process	= fourstereomixer;

fourstereomixer = (hgroup("in1",in1),hgroup("in2",in2),hgroup("in3",in3),hgroup("in4",in4)) 
        : ((stereochnl,stereochnl,stereochnl,stereochnl,stereochnl,stereochnl): rep(v1,v2,v3,v4,v5,v6,sa1,sa2,sa3,sa4,sa5,sa6,sb1,sb2,sb3,sb4,sb5,sb6) )~(del,rev) 
        : !,!,!,!,_,_;

del(l,r)=hgroup("del",l,r);
rev(l,r)=hgroup("rev",l,r);

stereochnl(r,l) = hgroup("chnl",r,l);                                                     // build channel 

rep(c1r,c1l,c2r,c2l,c3r,c3l,c4r,c4l,c5r,c5l,c6r,c6l,v1,v2,v3,v4,v5,v6,sa1,sa2,sa3,sa4,sa5,sa6,sb1,sb2,sb3,sb4,sb5,sb6) = vgroup("del",delb), vgroup("rev",revb), mout
with{                                                                                   // rework 
    delb = (c1r*sa1+c2r*sa2+c3r*sa3+c4r*sa4+c5r*sa5+c6r*sa6),(c1l*sa1+c2l*sa2+c3l*sa3+c4l*sa4+c5l*sa5+c6l*sa6);
    revb = (c1r*sb1+c2r*sb2+c3r*sb3+c4r*sb4+c5r*sb5+c6r*sb6),(c1l*sb1+c2l*sb2+c3l*sb3+c4l*sb4+c5l*sb5+c6l*sb6);
    mout = (c1r*v1+c2r*v2+c3r*v3+c4r*v4+c5r*v5+c6r*v6),(c1l*v1+c2l*v2+c3l*v3+c4l*v4+c5l*v5+c6l*v6);
}; 

mix = 
hgroup("chnlout",
    vgroup("1",channel(v1,l1,h1)),
    vgroup("2",channel(v2,l2,h2)),
    vgroup("3",channel(v3,l3,h3)),
    vgroup("4",channel(v4,l4,h4)),
    vgroup("5",channel(v5,l5,h5)),
    vgroup("6",channel(v6,l6,h6))
    ):sends(v1,sa1,sb1,v2,sa2,sb2,v3,sa3,sb3,v4,sa4,sb4,v5,sa5,sb5,v6,sa6,sb6);

sends(v1,sa1,sb1,v2,sa2,sb2,v3,sa3,sb3,v4,sa4,sb4,v5,sa5,sb5,v6,sa6,sb6,chnlout1,chnlout2,chnlout3,chnlout4,chnlout5,chnlout6) = delay,rev,main 
with{
    main  = chnlout1*v1  + chnlout2*v2  + chnlout3*v3  + chnlout4*v4  + chnlout5*v5  + chnlout6*v6;
    rev   = chnlout1*sa1 + chnlout2*sa2 + chnlout3*sa3 + chnlout4*sa4 + chnlout5*sa5 + chnlout6*sa6;
    delay = chnlout1*sb1 + chnlout2*sb2 + chnlout3*sb3 + chnlout4*sb4 + chnlout5*sb5 + chnlout6*sb6;
};

//sa1 sb1

channel(vol,l,h,in) = out
with{
    out =  fi.low_shelf( 6*l, 500 )
        : fi.high_shelf(6*h, 1500)
    ;
};